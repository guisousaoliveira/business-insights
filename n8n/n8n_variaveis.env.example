# ================================================================
# VARIÁVEIS DE AMBIENTE — n8n
# Configure em: n8n > Settings > Variables
# ================================================================
#
# Como configurar:
# 1. Abra o n8n
# 2. Vá em Settings (engrenagem no canto inferior esquerdo)
# 3. Clique em "Variables"
# 4. Adicione cada variável abaixo com seu valor real
#
# ================================================================

# ── Canal de notificação ──────────────────────────────────────────
# Escolha UM dos dois: 'whatsapp' ou 'email'
# Esta variável controla os três fluxos ao mesmo tempo
CANAL_NOTIFICACAO=whatsapp

# ── Supabase ──────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── FastAPI ───────────────────────────────────────────────────────
# URL base da sua instância FastAPI (Railway, Render, etc.)
FASTAPI_URL=https://salon-api.railway.app

# ── Segurança entre n8n e FastAPI ─────────────────────────────────
# String aleatória compartilhada — gere com: openssl rand -hex 32
# Configure o mesmo valor no .env do FastAPI como N8N_WEBHOOK_SECRET
N8N_WEBHOOK_SECRET=troque-por-uma-string-aleatoria-longa

# ── WhatsApp via Evolution API ────────────────────────────────────
# Só necessário se CANAL_NOTIFICACAO=whatsapp
# Documentação: https://doc.evolution-api.com
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_INSTANCE=salao-principal
EVOLUTION_API_KEY=sua-chave-da-evolution-api

# ── Email via SMTP ────────────────────────────────────────────────
# Só necessário se CANAL_NOTIFICACAO=email
# Configure também a Credential SMTP dentro do n8n (Settings > Credentials)
SMTP_FROM=noreply@seudominio.com
EMAIL_PROPRIETARIA=proprietaria@email.com

# ── Alertas de erro (vão para o time, não para a proprietária) ────
TELEFONE_DEV=5511999990000   # formato internacional sem + nem espaços
EMAIL_DEV=dev@seudominio.com
