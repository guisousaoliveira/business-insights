# ── Supabase ──────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Dashboard > Settings > API > JWT Secret. Usado para VALIDAR a assinatura
# dos tokens que o Flutter manda em Authorization: Bearer <token>.
SUPABASE_JWT_SECRET=...

# ── App ───────────────────────────────────────────────────────────
# Origem do Flutter (dev local ou domínio do PWA em produção)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://seu-app.vercel.app

# ── n8n Webhooks ──────────────────────────────────────────────────
# URL base do seu n8n + paths dos fluxos
N8N_BASE_URL=https://seu-n8n.exemplo.com
N8N_WEBHOOK_ALERTA_SALDO=webhook/alerta-saldo-mensal
N8N_WEBHOOK_RESUMO_SEMANAL=webhook/resumo-semanal
# Secret compartilhado que autentica as chamadas do n8n de volta para o FastAPI
# (POST /webhooks/*). Exigido em TODO ambiente, não só produção.
N8N_SECRET=...

# ── Ambiente ──────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
