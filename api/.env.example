# ── Supabase ──────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard > Settings > API
# Só a URL base do projeto — SEM /rest/v1 ou qualquer path no final. O
# client Python monta os caminhos de /auth, /rest etc. sozinho.
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# Chave "service_role" "secret" (atrás de um botão Reveal/Show no dashboard).
# NUNCA a "anon"/"public" — dá acesso total ao banco, bypassa RLS.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Chave "anon" "public" (a outra, sem Reveal). Usada só para login/refresh/
# logout (core/supabase_client.py::get_supabase_auth) — nunca para consulta
# administrativa.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Só necessário se o projeto ainda assina com o JWT Secret legado (HS256).
# Projeto novo usa chave assimétrica via JWKS e ignora esta variável — pode
# deixar em branco (ver core/security.py).
SUPABASE_JWT_SECRET=

# ── App ───────────────────────────────────────────────────────────
# Origem do Flutter (dev local ou domínio do PWA em produção)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://seu-app.vercel.app

# ── n8n Webhooks ──────────────────────────────────────────────────
# URL base do seu n8n + paths dos fluxos
N8N_BASE_URL=https://seu-n8n.exemplo.com
N8N_WEBHOOK_ALERTA_SALDO=webhook/alerta-saldo-mensal
N8N_WEBHOOK_RESUMO_SEMANAL=webhook/resumo-semanal
# Secret compartilhado que autentica as chamadas do n8n de volta para o FastAPI
# (POST /webhooks/*). Exigido em TODO ambiente, não só produção.
N8N_SECRET=...

# ── Ambiente ──────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
